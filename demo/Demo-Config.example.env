# Copy to demo-runtime/demo.env during Setup-Demo.ps1, then replace every CHANGE_ME value.
# This file contains no usable credentials. Never commit demo-runtime/demo.env.
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8766
APP_KEY=CHANGE_ME_GENERATED_BY_SETUP

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parkflow_demo_local
DB_USERNAME=parkflow_demo_app
DB_PASSWORD=CHANGE_ME_STRONG_DEMO_PASSWORD
DB_URL=

PARKING_TIMEZONE=Asia/Colombo
PARKING_PUBLIC_TICKET_URL=http://127.0.0.1:8766
PARKING_PUBLIC_TICKET_ALLOW_HTTP=true
PARKING_ANPR_ENGINE=http_local
PARKING_ANPR_SERVICE_URL=http://127.0.0.1:8765
PARKING_ANPR_SERVICE_TOKEN=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS
PARKING_GATE_DRIVER=log
PARKING_PAYMENT_GATEWAY=none
PARKING_PRINTER_DRIVER=browser

ANPR_SERVICE_TOKEN=CHANGE_ME_SAME_VALUE_AS_PARKING_ANPR_SERVICE_TOKEN
ANPR_BIND_HOST=127.0.0.1
ANPR_PORT=8765
ANPR_ENGINE=onnx
ANPR_MODELS_DIR=models
ANPR_REQUIRE_MANIFEST=true

# Launcher-only settings. LAN binding is disabled until deliberately enabled.
DEMO_LARAVEL_HOST=127.0.0.1
DEMO_LARAVEL_PORT=8766
DEMO_ANPR_PORT=8765
DEMO_ALLOW_LAN_BIND=false
DEMO_PHP_PATH=php
DEMO_COMPOSER_PATH=composer
DEMO_PYTHON_PATH=python

# Synthetic account password used only while seeding this disposable demo database.
SEED_DEMO_PASSWORD=CHANGE_ME_DEMO_LOGIN_PASSWORD
