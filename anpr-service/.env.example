# Copy to .env and replace the token. Never commit the populated .env file.
# Deliberately invalid until replaced; startup requires at least 32 random characters.
ANPR_SERVICE_TOKEN=change-me
ANPR_BIND_HOST=127.0.0.1
ANPR_PORT=8765
ANPR_ENGINE=onnx
ANPR_MODELS_DIR=models
ANPR_REQUIRE_MANIFEST=true

# Upload and CPU safeguards.
ANPR_MAX_IMAGE_BYTES=4194304
ANPR_MAX_IMAGE_PIXELS=25000000
ANPR_MAX_CANDIDATES=3
ANPR_MAX_CONCURRENCY=2
ANPR_QUEUE_TIMEOUT_SECONDS=5
ANPR_THREADS=2

# Detection/OCR policy. Keep staff verification enabled in Laravel.
ANPR_DETECTOR_CONF=0.35
ANPR_OCR_FULL_FRAME_FALLBACK=true
ANPR_ADAPTIVE_REVIEW_ENABLED=false
